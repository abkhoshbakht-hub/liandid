generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String
  role            String    @default("USER") // ADMIN, AUTHOR
  permissions     String    @default("[]") // JSON array of permissions
  avatar          String?
  bio             String?
  phone           String?
  isActive        Boolean   @default(true)
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  articles        Article[]
  comments        Comment[]
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  subtitle      String?
  content       String
  excerpt       String?
  featuredImage String?
  status        String    @default("DRAFT") // DRAFT, PENDING, PUBLISHED, ARCHIVED
  viewCount     Int       @default(0)
  isFeatured    Boolean   @default(false)
  isBreaking    Boolean   @default(false)
  isPinned      Boolean   @default(false)
  source        String?
  sourceUrl     String?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  category      Category? @relation(fields: [categoryId], references: [id])
  categoryId    String?
  tags          Tag[]
  comments      Comment[]
  metaTitle     String?
  metaDesc      String?
  metaKeywords  String?
  region        String?
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  color     String?
  order     Int       @default(0)
  articles  Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  article   Article  @relation(fields: [articleId], references: [id])
  articleId String
}

model ExternalNews {
  id            String           @id @default(cuid())
  title         String
  link          String           @unique
  description   String?
  image         String?
  source        String
  sourceName    String
  category      String?
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED
  isBreaking    Boolean          @default(false)
  region        String?          // e.g. "jam:city" | "jam:village" | "booshehr:city"
  topic         String?          // زیرموضوع: rahbari, dolat, bours, ...
  publishedAt   DateTime?
  fetchedAt     DateTime         @default(now())
  homepageSlots HomepageSlot[]
}

model HomepageSlot {
  id              String   @id @default(cuid())
  slotKey         String   @unique // hero-main, hero-side-1, hero-side-2, breaking-1..5, analysis-1..3
  label           String   // نام فارسی باکس
  type            String   @default("EXTERNAL") // EXTERNAL, CUSTOM
  externalNewsId  String?
  customTitle     String?
  customContent   String?
  customImage     String?
  customLink      String?
  category        String?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  externalNews ExternalNews? @relation(fields: [externalNewsId], references: [id])
}

model StaticPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  content       String
  excerpt       String?
  featuredImage String?
  authorName    String?
  authorImage   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserSubmission {
  id            String   @id @default(cuid())
  title         String
  content       String
  category      String
  mediaType     String   @default("PHOTO") // PHOTO, VIDEO, TEXT
  mediaUrl      String?
  fileName      String?
  senderName    String
  senderPhone   String?
  senderEmail   String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}