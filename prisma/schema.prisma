generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  password        String
  role            String    @default("USER") // ADMIN, AUTHOR
  permissions     String    @default("[]") // JSON array of permissions
  avatar          String?
  bio             String?
  phone           String?
  isActive        Boolean   @default(true)
  resetToken      String?
  resetTokenExpiry DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  articles        Article[]
  comments        Comment[]
}

model Article {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  subtitle      String?
  content       String
  excerpt       String?
  featuredImage String?
  status        String    @default("DRAFT") // DRAFT, PENDING, PUBLISHED, ARCHIVED
  viewCount     Int       @default(0)
  isFeatured    Boolean   @default(false)
  isBreaking    Boolean   @default(false)
  isPinned      Boolean   @default(false)
  placement     String    @default("latest") // latest, hero, analysis, pinned
  source        String?
  sourceUrl     String?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  author        User      @relation(fields: [authorId], references: [id])
  authorId      String
  category      Category? @relation(fields: [categoryId], references: [id])
  categoryId    String?
  tags          Tag[]
  comments      Comment[]
  metaTitle     String?
  metaDesc      String?
  metaKeywords  String?
  region        String?
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  icon      String?
  color     String?
  order     Int       @default(0)
  articles  Article[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  slug     String    @unique
  articles Article[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  article   Article  @relation(fields: [articleId], references: [id])
  articleId String
}

model ExternalNews {
  id            String           @id @default(cuid())
  title         String
  link          String           @unique
  description   String?
  image         String?
  source        String
  sourceName    String
  category      String?
  status        String           @default("PENDING") // PENDING, APPROVED, REJECTED
  isBreaking    Boolean          @default(false)
  region        String?          // e.g. "jam:city" | "jam:village" | "booshehr:city"
  topic         String?          // زیرموضوع: rahbari, dolat, bours, ...
  publishedAt   DateTime?
  fetchedAt     DateTime         @default(now())
  homepageSlots HomepageSlot[]
}

model HomepageSlot {
  id              String   @id @default(cuid())
  slotKey         String   @unique // hero-main, hero-side-1, hero-side-2, breaking-1..5, analysis-1..3
  label           String   // نام فارسی باکس
  type            String   @default("EXTERNAL") // EXTERNAL, CUSTOM
  externalNewsId  String?
  customTitle     String?
  customContent   String?
  customImage     String?
  customLink      String?
  category        String?
  isActive        Boolean  @default(true)
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  externalNews ExternalNews? @relation(fields: [externalNewsId], references: [id])
}

model StaticPage {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  content       String
  excerpt       String?
  featuredImage String?
  authorName    String?
  authorImage   String?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model UserSubmission {
  id            String   @id @default(cuid())
  title         String
  content       String
  category      String
  mediaType     String   @default("PHOTO") // PHOTO, VIDEO, TEXT
  mediaUrl      String?
  fileName      String?
  senderName    String
  senderPhone   String?
  senderEmail   String?
  status        String   @default("PENDING") // PENDING, APPROVED, REJECTED
  adminNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ===== لاگ اجراهای دریافت اخبار لحظه‌ای (RSS) =====
model RssFetchLog {
  id             String   @id @default(cuid())
  startedAt      DateTime @default(now())
  finishedAt     DateTime?
  durationMs     Int?
  status         String   @default("RUNNING") // RUNNING SUCCESS PARTIAL FAILED SKIPPED_LOCKED
  totalSources   Int      @default(0)
  successSources Int      @default(0)
  failedSources  Int      @default(0)
  newItems       Int      @default(0)
  updatedItems   Int      @default(0)
  errorSummary   String?
  triggerType    String   @default("manual") // cron admin manual external maintenance
  sources        RssFetchSourceLog[]
  createdAt      DateTime @default(now())
  @@index([createdAt])
  @@index([status])
}

model RssFetchSourceLog {
  id           String      @id @default(cuid())
  fetchLogId   String
  fetchLog     RssFetchLog @relation(fields: [fetchLogId], references: [id], onDelete: Cascade)
  source       String
  status       String      @default("PENDING") // SUCCESS FAILED TIMEOUT NO_NEW_ITEMS
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  durationMs   Int?
  fetchedCount Int         @default(0)
  newCount     Int         @default(0)
  error        String?
  retryCount   Int         @default(0)
  @@index([fetchLogId])
}

// ===== ماژول صفحه اول روزنامه‌ها =====
model Newspaper {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  category     String   @default("national") // national | bushehr | sports
  logo         String?
  website      String?
  telegram     String?
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sources      NewspaperSource[]
  issues       NewspaperIssue[]
  fetchLogs    NewspaperFetchLog[]
}

model NewspaperSource {
  id            String   @id @default(cuid())
  newspaperId   String
  name          String
  type          String   @default("official") // official | telegram | news_agency | other | manual
  url           String?
  priority      Int      @default(0)
  active        Boolean  @default(true)
  parserType    String?  // rss | telegram | html | manual
  configuration String?  // JSON
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  newspaper     Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  issues        NewspaperIssue[]
  fetchLogs     NewspaperFetchLog[]
  @@index([newspaperId])
}

model NewspaperIssue {
  id           String   @id @default(cuid())
  newspaperId  String
  date         DateTime // میلادی، نیمه‌شب UTC همان روز
  persianDate  String   // 1405-06-17
  issueNumber  String?
  title        String?
  originalUrl  String?
  imageUrl     String?
  thumbnailUrl String?
  sourceId     String?
  imageHash    String?  // SHA-256
  confidence   Int      @default(0)
  status       String   @default("PENDING") // PENDING PROCESSING PUBLISHED NEEDS_REVIEW FAILED REJECTED
  publishedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  newspaper    Newspaper @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  source       NewspaperSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  @@unique([newspaperId, date])
  @@index([date])
  @@index([status])
}

model NewspaperFetchLog {
  id                 String   @id @default(cuid())
  newspaperId        String?
  sourceId           String?
  startedAt          DateTime @default(now())
  finishedAt         DateTime?
  status             String   @default("FAILED") // SUCCESS FAILED SKIPPED INVALID_DATE INVALID_IMAGE DUPLICATE
  httpStatus         Int?
  errorMessage       String?
  discoveredImageUrl String?
  discoveredDate     String?
  responseTimeMs     Int?
  createdAt          DateTime @default(now())
  newspaper          Newspaper? @relation(fields: [newspaperId], references: [id], onDelete: Cascade)
  source             NewspaperSource? @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  @@index([newspaperId])
  @@index([createdAt])
}